+  it("retries a handoff when admission fails after the receipt is claimed", async () => {
+    const f = await seed();
+    const receipt = await strand(f);
+    await releaseLease(f);
+    await db.execute(sql`create function fail_readmitted_wake() returns trigger language plpgsql as $$
+      begin
+        if new.idempotency_key like 'lease-handoff-readmit:%' then
+          raise exception 'injected readmission failure';
+        end if;
+        return new;
+      end
+    $$`);
+    await db.execute(sql`create trigger fail_readmitted_wake before insert on agent_wakeup_requests
+      for each row execute function fail_readmitted_wake()`);
+    try {
+      await heartbeatService(db).readmitLeaseBlockedHandoffs(outgoingRun(f), f.issueId);
+      expect(await issueRuns(f)).toHaveLength(0);
+    } finally {
+      await db.execute(sql`drop trigger fail_readmitted_wake on agent_wakeup_requests`);
+      await db.execute(sql`drop function fail_readmitted_wake()`);
